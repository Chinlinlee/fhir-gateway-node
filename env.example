PROXY_TO=http://localhost:8081/fhir
TOKEN_ISSUER=http://localhost:9080/realms/smart
BACKEND_TYPE=HAPI
ACCESS_CHECKER=patient
RUN_MODE=DEV
# 驗簽金鑰來源：jwks（OIDC discovery 的 jwks_uri）、keycloak-public-key（Keycloak root public_key）、auto（先試 jwks 再退回）
SIGNING_KEY_SOURCE=auto
# JWT iss host 可與 TOKEN_ISSUER 不同但 realm path 相同（如 Keycloak localhost vs LAN IP）
ALLOW_TOKEN_ISSUER_HOST_MISMATCH=false
# 本 gateway 接受的 access token aud 值（逗號分隔多個）。留空 = 不校驗 aud（升級安全的預設）
TOKEN_AUDIENCE=
PORT=3000
WELL_KNOWN_ENDPOINT=.well-known/openid-configuration
ALLOWED_QUERIES_FILE=
AUDIT_EVENT_ACTIONS_CONFIG=
# 是否啟用 EHR 面向的內部 launch context 註冊端點（POST /internal/launch-contexts）。預設 false。
# ACCESS_CHECKER=patient 或 list 時這是必要條件：launch context 由 gateway 自己持有，
# EHR 不註冊就沒有病人參照，請求一律 401（ADR-0002）
INTERNAL_LAUNCH_API_ENABLED=false
# 內部 launch context 端點的認證憑證，以 X-Internal-Credential header 送出。
# 端點啟用而未設定此值時，gateway 啟動即失敗。與 patient-facing bearer token 完全分開
INTERNAL_LAUNCH_API_CREDENTIAL=
# 未綁定 launch context 的存活秒數：EHR 註冊之後、使用者還沒在 IdP 按下同意的視窗（預設 600）。
# 過期後這個 launch id 視為不存在，`authorize` 帶著它進來會以 400 拒絕
LAUNCH_CONTEXT_TTL_SECONDS=600
# 已綁定 launch context 的存活秒數（預設 14400，也就是 4 小時）。到期之後 patient／list
# 模式的請求以 401 拒絕。4 小時的理由見 ADR-0004：臨床實務上醫師處理同一位病人可能需要那麼久，
# 因此這同時也是「撤銷最壞要等多久」的上限。TTL 是固定值，refresh 不延長它
LAUNCH_CONTEXT_BOUND_TTL_SECONDS=14400
# launch context store 的實作：memory（測試／單機開發）或 valkey（正式環境）。
# memory 的綁定只活在 process 記憶體裡：gateway 一重啟所有進行中的 launch 就失效，
# 多個 instance 之間也互相看不到——RUN_MODE=PROD 時 gateway 會在啟動時明確警告這一點。
# 正式環境請設 valkey
LAUNCH_CONTEXT_STORE=memory
# Valkey 連線 URL。選 valkey 而未設定時，gateway 啟動即失敗並指名這個變數。
# store 裡放著病人與就診參照（PHI）與 access token 的綁定索引（**不是** IdP 的 token 本體），
# 因此正式環境的連線 **必須**加密並且有認證：`rediss://<user>:<password>@<host>:6379`
LAUNCH_CONTEXT_VALKEY_URL=
# gateway 對外可被 SMART App 呼叫的 base URL。設定它等同啟用代理的 SMART authorization flow：
# gateway 把 authorization／token endpoint 改宣告成自己並代理它們，issuer 維持 IdP 的原值。
# 端點改寫一律用這個值，絕不從請求的 Host header 推導。留空 = 不代理，維持被動
GATEWAY_PUBLIC_BASE_URL=
# gateway 自己當 IdP client 的憑證：callback 時用它向 IdP 的 token endpoint 換 token。
# 必須是 IdP 上已註冊的 confidential client，並登錄 gateway 自己的 callback 為 redirect URI。
# gateway 仍然不簽任何 token，簽發權與 access token 都在 IdP 手上（ADR-0001）。
# 設定 GATEWAY_PUBLIC_BASE_URL 而缺任一項時，gateway 啟動即失敗並指名該變數。
# 留空 = gateway 不參與 authorization flow，此時沒有任何綁定會發生，
# ACCESS_CHECKER=patient／list 的請求一律 401——這是 ADR-0002 硬切的結果，不是可退化的設定
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=
