{
    "name": "fhir-gateway-node",
    "version": "1.0.0",
    "description": "FHIR Information Gateway — Elysia/Node implementation",
    "type": "module",
    "main": "dist/index.cjs",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsdown",
        "start": "node dist/index.cjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "biome format --write",
        "generate:patient-params": "node scripts/generate-patient-params.mjs"
    },
    "keywords": [
        "fhir",
        "elysia",
        "smart-on-fhir"
    ],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.28.0",
    "dependencies": {
        "@elysia/node": "^1.4.6",
        "@elysiajs/cors": "^1.4.2",
        "@sinclair/typebox": "^0.34.49",
        "dotenv": "^17.4.2",
        "elysia": "^1.4.28",
        "fhir-kit-client": "^2.0.2",
        "fhirpath": "^4.10.1",
        "google-auth-library": "^10.6.2",
        "jose": "^6.2.3",
        "undici": "^8.3.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.16",
        "@elysiajs/eden": "^1.4.9",
        "@types/fhir": "^0.0.43",
        "@types/node": "^25.9.1",
        "tsdown": "^0.22.1",
        "tsx": "^4.22.3",
        "typescript": "^6.0.3",
        "vitest": "^4.1.7"
    }
}
